# AssemblyAI API key — claim hackathon credits via the lablab sign-up link first.
# Copy this file to `.env.local` and fill it in. Never commit real keys.
ASSEMBLYAI_API_KEY=

# Stored Voice Agent id — run `node scripts/create-agent.mjs` (it prints this exact line; it never edits this file).
AGENT_ID=

# Optional LLM second opinion for coaching detection. Rules ALWAYS run first and need no key; the LLM is only
# consulted when the rules find nothing. Leave unset for rules only.
# DETECT_MODEL=qwen3.5-4b-32k-fast
# DETECT_STRUCTURED=0   # needed for models that reject response_format (e.g. qwen3.5-4b-32k-fast)
